{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "brr:brr_ears",
			"render_controllers": [
				"controller.render.armor"
			],
			"materials": {
				"default": "entity_alphatest_glint",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/entity/attachable/brr_ears",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.brr_ears"
			},
			"scripts": {
				"animate": [
					// Conditional animation based on speed
					{
						"idle": "query.ground_speed <= 0.01"
					}, // Play idle when not moving
					{
						"walk": "query.ground_speed > 0.01"
					} // Play walk when moving
				]
			},
			"animations": {
				"idle": "animation.brr_ears.idle",
				"walk": "animation.brr_ears.walk"
			}
		}
	}
}
